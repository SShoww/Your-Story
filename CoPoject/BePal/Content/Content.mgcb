
#----------------------------- Global Properties ----------------------------#

/outputDir:bin/$(Platform)
/intermediateDir:obj/$(Platform)
/platform:DesktopGL
/config:
/profile:Reach
/compress:False

#-------------------------------- References --------------------------------#

#---------------------------------- Content ---------------------------------#

#begin PrototypeFont.spritefont
/importer:FontDescriptionImporter
/processor:FontDescriptionProcessor
/processorParam:PremultiplyAlpha=True
/processorParam:TextureFormat=Compressed
/build:PrototypeFont.spritefont

#begin pet/spr_pet_idle.png
/importer:TextureImporter
/processor:TextureProcessor
/build:pet/spr_pet_idle.png

#begin pet/spr_pet_happy.png
/importer:TextureImporter
/processor:TextureProcessor
/build:pet/spr_pet_happy.png

#begin pet/spr_pet_angry.png
/importer:TextureImporter
/processor:TextureProcessor
/build:pet/spr_pet_angry.png
